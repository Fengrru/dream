# Dream environment — copy to `.env` and fill in what you need.
# Everything is optional: Dream runs fully offline (scripted reasoning +
# local deterministic embeddings) with no configuration at all.

# ---- Reasoning (any OpenAI-compatible chat provider) ----------------------
# DeepSeek (used in the project's own testing):
DREAM_API_KEY=
DREAM_BASE_URL=https://api.deepseek.com/v1
DREAM_MODEL=deepseek-chat
# Other examples:
#   DREAM_BASE_URL=https://api.openai.com/v1   DREAM_MODEL=gpt-4o-mini
#   DREAM_BASE_URL=http://localhost:11434/v1   DREAM_MODEL=qwen2.5   (Ollama)

# ---- Embeddings (optional) ------------------------------------------------
# Chat providers (DeepSeek included) expose no embeddings endpoint, so the
# memory kernel defaults to a local deterministic feature-hashing embedder.
# Point these at a real embeddings API when your memory outgrows it; note the
# similarity thresholds in ARCHITECTURE.md are calibrated for the local one.
# DREAM_EMBED_MODEL=text-embedding-3-small
# DREAM_EMBED_BASE_URL=https://api.openai.com/v1
# DREAM_EMBED_API_KEY=sk-...

# ---- MCP servers (optional) ------------------------------------------------
# Path to a JSON file: [{"name": "fs", "command": "npx", "args": ["-y", "@modelcontextprotocol/server-filesystem", "/tmp"]}]
# Every MCP tool is registered as mcp__<name>__<tool> and passes through the
# same single tool pipeline (policy hooks, journal, loop detection).
# DREAM_MCP_CONFIG=mcp-servers.json
